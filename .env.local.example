# Isi dengan kredensial project Supabase Anda (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx

# HANYA untuk server-side (dipakai panel admin). JANGAN commit ke git,
# JANGAN pernah dipakai di kode client/browser.
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# Passcode untuk login admin TU (bebas ditentukan, ganti dengan kode yang mudah diingat tapi tidak mudah ditebak)
ADMIN_PASSCODE=gantidengankodeanda

# Kunci acak untuk menandatangani cookie sesi admin (isi bebas, string panjang & acak)
SESSION_SECRET=gantidengankunciacakminimal32karakter
